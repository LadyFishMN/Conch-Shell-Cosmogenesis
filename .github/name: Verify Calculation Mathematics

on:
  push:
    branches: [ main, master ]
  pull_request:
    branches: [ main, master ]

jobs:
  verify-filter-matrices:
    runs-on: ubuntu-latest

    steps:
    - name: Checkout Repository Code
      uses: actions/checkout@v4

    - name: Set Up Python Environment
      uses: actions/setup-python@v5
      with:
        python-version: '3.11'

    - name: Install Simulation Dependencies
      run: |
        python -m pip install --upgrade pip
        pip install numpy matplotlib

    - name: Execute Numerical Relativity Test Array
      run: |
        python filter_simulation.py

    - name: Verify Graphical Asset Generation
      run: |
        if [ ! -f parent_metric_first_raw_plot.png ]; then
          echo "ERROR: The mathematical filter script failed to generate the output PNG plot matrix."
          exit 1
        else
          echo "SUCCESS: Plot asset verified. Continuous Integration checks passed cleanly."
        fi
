name: Verify Calculation Mathematics

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  verify-filter-matrices:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Repository Code
      uses: actions/checkout@v4

    - name: Set Up Python Environment
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'

    - name: Install Simulation Dependencies
      run: |
        python -m pip install --upgrade pip
        pip install numpy matplotlib

    - name: Execute Numerical Relativity Test Array
      run: |
        python filter_simulation.py

    - name: Verify Graphical Asset Generation
      run: |
        if [ ! -f parent_metric_first_raw_plot.png ]; then
          echo "ERROR: The mathematical filter script failed to generate the output PNG plot matrix."
          exit 1
        else
          echo "SUCCESS: Plot asset verified. Continuous Integration checks passed cleanly."
        fi
